# MongoDB (appType: mongo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=app
JWT_SECRET=change-me-to-a-long-random-secret

# Demo account — must match .env.example, which is the committed source.
DEMO_ADMIN_EMAIL=demo@iclouds.co.uk
DEMO_ADMIN_PASSWORD=123456

# Cloudflare R2 (S3-compatible storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=app
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=