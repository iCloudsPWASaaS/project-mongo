# MongoDB (appType: mongo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=app
JWT_SECRET=change-me-to-a-long-random-secret

# Demo account — must match .env.example, which is the committed source.
DEMO_ADMIN_EMAIL=demo@weblify.app
DEMO_ADMIN_PASSWORD=kR7mq2Xp9vT4

# Cloudflare R2 (S3-compatible storage).
# Left blank on purpose: the platform stamps the real account and keys into each
# app's own env at provision time (see stampR2 in the backend).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=app
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=