# MongoDB (appType: mongo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=app
JWT_SECRET=change-me-to-a-long-random-secret

# Demo account, seeded on first database access (app/api/auth/*).
#
# The credential belongs to this repo, not to the platform: edit it here, and the
# dashboard reads it back out of the app's own .env to show the owner. See
# lib/demo-user.ts.
DEMO_ADMIN_EMAIL=demo@weblify.app
DEMO_ADMIN_PASSWORD=kR7mq2Xp9vT4

# Cloudflare R2 (S3-compatible storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=app
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=
